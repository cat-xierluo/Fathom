# Agent Email 环境配置

# ── 默认后端（claw | agently）──
# 用 ${MAIL_PROVIDER:-claw}：若调用前已 export MAIL_PROVIDER=agently，则尊重该显式值；
# 否则回退到 claw。避免 source .env 静默覆盖用户显式指定的后端。
MAIL_PROVIDER=${MAIL_PROVIDER:-agently}

# ── 本 Agent 邮箱（网易 ClawEmail）──
AGENT_EMAIL=maoking.agent@claw.163.com
DISPLAY_NAME="杨卫薪Agent（Claude Code）"
CLAW_PREFIX=maoking.agent

# ── mail-cli 配置 ──
CLAW_PROFILE=default

# ── 本 Agent 邮箱（腾讯 Agent Mail）──
AGENTLY_EMAIL=maoking@agent.qq.com
AGENTLY_NAME="maoking agent"

# ── 文件夹 ID ──
INBOX_FID=1
SENT_FID=3

# ── 已知邮箱（发任务 / 收发材料时直接引用）──

# Agent
AGENT_MANUS=maoking@manus.bot

# 个人邮箱
CONTACT_163=secretxierluo@163.com
CONTACT_GMAIL=secretxierluo@gmail.com
