{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fathom",
  "version": "0.3.0",
  "identifier": "com.maoscripts.fathom",
  "build": {
    "frontendDist": "../frontend-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Fathom",
        "width": 1220,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' http://127.0.0.1:7952 http://localhost:7952; script-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "resources": [
      "resources/helper/**"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null,
      "entitlements": null,
      "exceptionDomain": null
    },
    "category": "DeveloperTool",
    "shortDescription": "Fathom — 本机目录容量历史追踪",
    "longDescription": "Fathom 在 macOS 本机追踪目录容量变化，按根与阈值生成历史快照，并通过内置 FastAPI 仪表盘展示。"
  }
}
