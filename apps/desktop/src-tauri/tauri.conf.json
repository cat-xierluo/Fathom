{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fathom",
  "version": "0.3.3",
  "identifier": "com.maoscripts.fathom",
  "build": {
    "frontendDist": "../frontend-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Fathom",
        "width": 1220,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' http://127.0.0.1:7952 http://localhost:7952; script-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgzOTE2MjJCQjU2ODdFRjUKUldUMWZtaTFLMktSZzNFNUtCdEtRdjVwRTRkbm54Tkh6T0kvdHVpLzE1UzhSUlM1a0ViT1Rtd0oK",
      "endpoints": [
        "https://github.com/cat-xierluo/fathom/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/helper/fathom-helper/": "helper/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null,
      "entitlements": null,
      "exceptionDomain": null,
      "dmg": {
        "background": "icons/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 480
        },
        "appPosition": {
          "x": 170,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 360,
          "y": 170
        }
      }
    },
    "category": "DeveloperTool",
    "shortDescription": "Fathom — 本机目录容量历史追踪",
    "longDescription": "Fathom 在 macOS 本机追踪目录容量变化，按根与阈值生成历史快照，并通过内置 FastAPI 仪表盘展示。"
  }
}
